    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Battery health from the most recent inventory of each ThinkPad. Devices show **Unavailable** when the Commercial Vantage battery policy is not enabled. Select a slice to filter the list, and select it again to clear the filter."
            },
            "name": "BatteryDescription"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| where isnotempty(BatteryHealth_s)\r\n| extend BatteryHealth = iff(BatteryHealth_s == 'Battery Data Unavailable', 'Unavailable', BatteryHealth_s)\r\n| summarize Devices = count() by BatteryHealth",
              "size": 3,
              "title": "Battery Health",
              "noDataMessage": "No battery data found. Battery health is collected from ThinkPad devices only.",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "series",
              "exportParameterName": "BatteryHealth",
              "exportDefaultValue": "All",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
