        "value": "Updates"
      },
      "name": "UpdateStatus"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Compares the installed BIOS with the latest version in the Lenovo catalog. The CVE list comes from the readme of the latest BIOS and shows the accumulated vulnerabilities that have been addressed through BIOS updates. Review the [Lenovo Product Security Advisories](https://support.lenovo.com/product_security/ps500001-lenovo-product-security-advisories) for details."
            },
            "name": "BiosDescription"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "7a1d3b8f-4e2c-4d66-8b9f-3c8e5a2f0d41",
                  "version": "KqlParameterItem/1.0",
                  "name": "BiosStatusFilter",
                  "label": "BIOS Status",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Lenovo_Device_Properties_CL\r\n| summarize arg_max(TimeGenerated, AvailableBiosVersion_s) by Hostname_s\r\n| extend BiosStatus = case(\r\n    AvailableBiosVersion_s contains 'is current', 'Current',\r\n    AvailableBiosVersion_s contains 'Available version', 'Out of Date',\r\n    'Unavailable')\r\n| summarize by BiosStatus\r\n| order by BiosStatus asc",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "timeContext": {
                    "durationMs": 2592000000
                  },
                  "timeContextFromParameter": "TimeRange",
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "value": [
                    "Out of Date"
                  ]
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "BiosParameters"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| extend BiosStatus = case(\r\n    AvailableBiosVersion_s contains 'is current', 'Current',\r\n    AvailableBiosVersion_s contains 'Available version', 'Out of Date',\r\n    'Unavailable')\r\n| where BiosStatus in ({BiosStatusFilter})\r\n| summarize Devices = count() by Product_s, BiosStatus\r\n| order by Product_s asc",
              "size": 0,
              "title": "BIOS Status by Model",
              "noDataMessage": "No BIOS data found.",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "categoricalbar",
              "chartSettings": {
                "xAxis": "Product_s",
                "yAxis": [
                  "Devices"
                ],
                "group": "BiosStatus",
                "createOtherGroup": 0,
                "showLegend": true,
                "seriesLabelSettings": [
                  {
                    "seriesName": "Current",
                    "color": "green"
                  },
                  {
                    "seriesName": "Out of Date",
                    "color": "orange"
                  },
                  {
                    "seriesName": "Unavailable",
                    "color": "gray"
                  }
                ]
              }
            },
            "name": "BiosStatusChart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| extend BiosStatus = case(\r\n    AvailableBiosVersion_s contains 'is current', 'Current',\r\n    AvailableBiosVersion_s contains 'Available version', 'Out of Date',\r\n    'Unavailable')\r\n| where BiosStatus in ({BiosStatusFilter})\r\n| extend CVEList = extract_all(@'(CVE-\\d{4}-\\d+)', CVE_s)\r\n| order by case(BiosStatus == 'Out of Date', 1, BiosStatus == 'Unavailable', 2, 3) asc, coalesce(array_length(CVEList), 0) desc, Hostname_s asc\r\n| project\r\n    Hostname = Hostname_s,\r\n    Product = Product_s,\r\n    MachineType = MTM_s,\r\n    BiosStatus,\r\n    InstalledBios = InstalledBiosVersion_s,\r\n    AvailableBios = extract(@'Available version: (\\S+)', 1, AvailableBiosVersion_s),\r\n    Released = extract(@'released ([^;]+)', 1, AvailableBiosVersion_s),\r\n    CVECount = coalesce(array_length(CVEList), 0),\r\n    CVEs = strcat_array(CVEList, ', '),\r\n    LastReported = TimeGenerated",
              "size": 0,
              "title": "BIOS and CVE Details",
              "noDataMessage": "No devices match the selected BIOS status.",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "BiosStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Current",
                          "representation": "success",
                          "text": "{0}{1}"
                        },
                        {
