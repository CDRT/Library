    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Counts use the most recent inventory from each device in the selected time range. Devices that stopped reporting before the time range began are not listed. With the Remediation on a weekly schedule, a device that has not reported in more than 7 days has missed a run."
            },
            "name": "OverviewDescription"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nlet Updates = Lenovo_Device_Health_CL\r\n    | join kind=inner (\r\n        Lenovo_Device_Health_CL\r\n        | summarize TimeGenerated = max(TimeGenerated) by Hostname_s\r\n        ) on Hostname_s, TimeGenerated\r\n    | join kind=inner (Devices | project Hostname_s, Product_s, MTM_s) on Hostname_s;\r\nunion\r\n    (Devices | summarize Value = count() | extend Metric = 'Devices Reporting', Order = 1),\r\n    (Devices\r\n| extend BiosStatus = case(\r\n    AvailableBiosVersion_s contains 'is current', 'Current',\r\n    AvailableBiosVersion_s contains 'Available version', 'Out of Date',\r\n    'Unavailable')\r\n    | where BiosStatus == 'Out of Date'\r\n    | summarize Value = count() | extend Metric = 'BIOS Out of Date', Order = 2),\r\n    (Updates\r\n    | where Status_s in ('Applicable', 'NotInstalled') or Status_s contains 'Fail'\r\n    | summarize Value = dcount(Hostname_s) | extend Metric = 'Devices With Pending or Failed Updates', Order = 3),\r\n    (Devices | where BatteryHealth_s == 'Red' | summarize Value = count() | extend Metric = 'Batteries in Red Health', Order = 4),\r\n    (Devices\r\n    | extend EndDate = todatetime(WarrantyEnd_s)\r\n    | where EndDate >= now() and EndDate < now(90d)\r\n    | summarize Value = count() | extend Metric = 'Warranties Expiring Within 90 Days', Order = 5),\r\n    (Devices | where TimeGenerated < ago(7d) | summarize Value = count() | extend Metric = 'Not Reported in 7+ Days', Order = 6)\r\n| order by Order asc\r\n| project Metric, Value",
              "size": 3,
              "title": "Fleet Summary (Latest Inventory per Device)",
              "noDataMessage": "No inventory found. Verify devices have run the Remediation.",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0
                    }
                  }
                },
                "showBorder": true
              }
            },
            "name": "OverviewTiles"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| where TimeGenerated < ago(7d)\r\n| project\r\n    Hostname = Hostname_s,\r\n    Product = Product_s,\r\n    MachineType = MTM_s,\r\n    Serial = Serial_s,\r\n    LastReported = TimeGenerated\r\n| order by LastReported asc",
              "size": 0,
              "title": "Devices Not Reported in 7+ Days",
              "noDataMessage": "All devices have reported within the last 7 days.",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "LastReported",
                    "formatter": 6
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Hostname",
                    "label": "Computer Name"
                  },
                  {
                    "columnId": "MachineType",
                    "label": "Machine Type"
                  },
                  {
                    "columnId": "LastReported",
                    "label": "Last Reported"
                  }
                ]
              }
            },
            "name": "StaleDevices"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Overview"
      },
      "name": "Overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Shows the update status from the most recent inventory of each device. Status values come from the **Lenovo_Updates** WMI class and depend on the tool that wrote them, such as Commercial Vantage, Lenovo Client Update, System Update, or Thin Installer. Select a device to view its updates."
            },
            "name": "UpdateStatusDescription"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "6f0c2a7e-3d1b-4c55-9a8e-2b7d4f1e9c30",
                  "version": "KqlParameterItem/1.0",
                  "name": "Status",
                  "label": "Update Status",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Lenovo_Device_Health_CL\r\n| summarize by Status_s\r\n| order by Status_s asc",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "timeContext": {
                    "durationMs": 2592000000
                  },
                  "timeContextFromParameter": "TimeRange",
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "value": [
                    "value::all"
                  ]
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "UpdateStatusParameters"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nlet Updates = Lenovo_Device_Health_CL\r\n    | join kind=inner (\r\n        Lenovo_Device_Health_CL\r\n        | summarize TimeGenerated = max(TimeGenerated) by Hostname_s\r\n        ) on Hostname_s, TimeGenerated\r\n    | join kind=inner (Devices | project Hostname_s, Product_s, MTM_s) on Hostname_s;\r\nUpdates\r\n| where Status_s in ({Status})\r\n| summarize Updates = count() by Status_s",
              "size": 3,
              "title": "Updates by Status",
              "noDataMessage": "No update data found. Verify devices have run the Remediation and that the Lenovo_Updates WMI class is populated.",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "Installed",
                    "color": "green"
                  },
                  {
                    "seriesName": "InstallSuccess",
                    "color": "greenDark"
                  },
                  {
                    "seriesName": "AlreadyInstalled",
                    "color": "blue"
                  },
                  {
                    "seriesName": "Applicable",
                    "color": "orange"
                  },
                  {
                    "seriesName": "NotInstalled",
                    "color": "orange"
                  },
                  {
                    "seriesName": "NotApplicable",
                    "color": "gray"
                  },
                  {
                    "seriesName": "InstallFailed",
                    "color": "redBright"
                  },
                  {
                    "seriesName": "DownloadFailed",
                    "color": "red"
                  }
                ]
              }
            },
            "name": "UpdateStatusChart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nlet Updates = Lenovo_Device_Health_CL\r\n    | join kind=inner (\r\n        Lenovo_Device_Health_CL\r\n        | summarize TimeGenerated = max(TimeGenerated) by Hostname_s\r\n        ) on Hostname_s, TimeGenerated\r\n    | join kind=inner (Devices | project Hostname_s, Product_s, MTM_s) on Hostname_s;\r\nUpdates\r\n| where Status_s in ({Status})\r\n| summarize\r\n    Installed = countif(Status_s in ('Installed', 'InstallSuccess', 'AlreadyInstalled')),\r\n    Pending = countif(Status_s in ('Applicable', 'NotInstalled')),\r\n    Failed = countif(Status_s contains 'Fail'),\r\n    NotApplicable = countif(Status_s == 'NotApplicable'),\r\n    Total = count(),\r\n    LastReported = max(TimeGenerated)\r\n    by Hostname = Hostname_s, Product = Product_s, MachineType = MTM_s\r\n| order by Failed desc, Pending desc, Hostname asc",
              "size": 0,
              "title": "Updates by Device",
              "noDataMessage": "No updates match the selected filters.",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "Hostname",
              "exportParameterName": "SelectedDevice",
              "exportDefaultValue": "None",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Pending",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "orange"
                    }
                  },
                  {
                    "columnMatch": "Failed",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "LastReported",
                    "formatter": 6
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "$gen_heatmap_Pending_4",
                    "sortOrder": 2
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "Hostname",
                    "label": "Computer Name"
                  },
                  {
                    "columnId": "MachineType",
                    "label": "Machine Type"
                  },
                  {
                    "columnId": "NotApplicable",
                    "label": "Not Applicable"
                  },
                  {
                    "columnId": "LastReported",
                    "label": "Last Reported"
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "$gen_heatmap_Pending_4",
                  "sortOrder": 2
                }
              ]
            },
            "name": "UpdatesByDevice"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nlet Updates = Lenovo_Device_Health_CL\r\n    | join kind=inner (\r\n        Lenovo_Device_Health_CL\r\n        | summarize TimeGenerated = max(TimeGenerated) by Hostname_s\r\n        ) on Hostname_s, TimeGenerated\r\n    | join kind=inner (Devices | project Hostname_s, Product_s, MTM_s) on Hostname_s;\r\nUpdates\r\n| where Hostname_s == '{SelectedDevice}' and Status_s in ({Status})\r\n| order by case(Status_s contains 'Fail', 1, Status_s in ('Applicable', 'NotInstalled'), 2, Status_s == 'NotApplicable', 4, 3) asc, Title_s asc\r\n| project\r\n    Title = Title_s,\r\n    Version = Version_s,\r\n    Severity = Severity_s,\r\n    Status = Status_s,\r\n    PackageID = PackageID_s,\r\n    LastReported = TimeGenerated",
              "size": 0,
              "title": "Updates on {SelectedDevice}",
              "noDataMessage": "No updates match the selected filters.",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Status",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
