                        },
                        {
                          "operator": "==",
                          "thresholdValue": "AlreadyInstalled",
                          "representation": "success",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Applicable",
                          "representation": "warning",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotInstalled",
                          "representation": "warning",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotApplicable",
                          "representation": "Unknown",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
