    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Warranty end dates from the most recent inventory of each device. Devices show **Unavailable** when the Commercial Vantage warranty policy is not enabled. Select a slice to filter the list, and select it again to clear the filter."
            },
            "name": "WarrantyDescription"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| extend EndDate = todatetime(WarrantyEnd_s)\r\n| extend WarrantyStatus = case(\r\n    isnull(EndDate), 'Unavailable',\r\n    EndDate < now(), 'Expired',\r\n    EndDate < now(90d), 'Expires Within 90 Days',\r\n    EndDate < now(365d), 'Expires Within 1 Year',\r\n    'More Than 1 Year')\r\n| summarize Devices = count() by WarrantyStatus",
              "size": 3,
              "title": "Warranty Status",
              "noDataMessage": "No warranty data found.",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "series",
              "exportParameterName": "WarrantyStatus",
              "exportDefaultValue": "All",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "Expired",
                    "color": "redBright"
                  },
                  {
                    "seriesName": "Expires Within 90 Days",
                    "color": "orange"
                  },
                  {
                    "seriesName": "Expires Within 1 Year",
                    "color": "yellow"
                  },
                  {
                    "seriesName": "More Than 1 Year",
                    "color": "green"
                  },
                  {
                    "seriesName": "Unavailable",
                    "color": "gray"
                  }
                ]
              }
            },
            "customWidth": "50",
            "name": "WarrantyStatusChart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| extend EndDate = todatetime(WarrantyEnd_s)\r\n| where isnotnull(EndDate)\r\n| summarize Devices = count() by Year = tostring(getyear(EndDate))\r\n| order by Year asc",
              "size": 3,
              "title": "Warranty End by Year",
              "noDataMessage": "No warranty data found.",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart"
            },
            "customWidth": "50",
            "name": "WarrantyByYear"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| extend EndDate = todatetime(WarrantyEnd_s)\r\n| extend WarrantyStatus = case(\r\n    isnull(EndDate), 'Unavailable',\r\n    EndDate < now(), 'Expired',\r\n    EndDate < now(90d), 'Expires Within 90 Days',\r\n    EndDate < now(365d), 'Expires Within 1 Year',\r\n    'More Than 1 Year')\r\n| where '{WarrantyStatus}' == 'All' or WarrantyStatus == '{WarrantyStatus}'\r\n| project\r\n    Hostname = Hostname_s,\r\n    Product = Product_s,\r\n    MachineType = MTM_s,\r\n    Serial = Serial_s,\r\n    WarrantyStatus,\r\n    WarrantyEnd = format_datetime(EndDate, 'yyyy-MM-dd'),\r\n    DaysRemaining = datetime_diff('day', EndDate, now()),\r\n    LastReported = TimeGenerated\r\n| order by DaysRemaining asc nulls last, Hostname asc",
              "size": 0,
              "title": "Warranty by Device",
              "noDataMessage": "No devices match the selected warranty status.",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "WarrantyStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Expired",
                          "representation": "critical",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Expires Within 90 Days",
                          "representation": "warning",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Expires Within 1 Year",
                          "representation": "info",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "More Than 1 Year",
                          "representation": "success",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Unavailable",
                          "representation": "Unknown",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "Blank",
                          "text": "{0}{1}"
                        }
                      ]
