                      ]
                    }
                  },
                  {
                    "columnMatch": "LastReported",
                    "formatter": 6
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Title",
                    "label": "Update"
                  },
                  {
                    "columnId": "PackageID",
                    "label": "Package ID"
                  },
                  {
                    "columnId": "LastReported",
                    "label": "Last Reported"
                  }
                ]
              }
            },
            "conditionalVisibility": {
              "parameterName": "SelectedDevice",
              "comparison": "isNotEqualTo",
              "value": "None"
            },
            "name": "UpdatesForDevice"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
