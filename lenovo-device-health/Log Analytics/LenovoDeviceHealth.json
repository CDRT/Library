            "name": "BatteryHealthChart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Devices = Lenovo_Device_Properties_CL\r\n    | summarize arg_max(TimeGenerated, *) by Hostname_s\r\n    | where Product_s in ({Product});\r\nDevices\r\n| where isnotempty(BatteryHealth_s)\r\n| extend BatteryHealth = iff(BatteryHealth_s == 'Battery Data Unavailable', 'Unavailable', BatteryHealth_s)\r\n| where '{BatteryHealth}' == 'All' or BatteryHealth == '{BatteryHealth}'\r\n| order by case(BatteryHealth == 'Red', 1, BatteryHealth == 'Yellow', 2, BatteryHealth == 'Unavailable', 3, 4) asc, Hostname_s asc\r\n| project\r\n    Hostname = Hostname_s,\r\n    Product = Product_s,\r\n    MachineType = MTM_s,\r\n    Serial = Serial_s,\r\n    BatteryHealth,\r\n    LastReported = TimeGenerated",
